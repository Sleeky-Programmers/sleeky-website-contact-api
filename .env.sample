EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
RECAPTCHA_SECRET_KEY=
# Set to true to skip reCAPTCHA while testing (local or Vercel preview). Ignored in production.
RECAPTCHA_DISABLED=

# The EMAIL_* settings above are only used by the older /email contact form.

# Zoho CRM: every "Start a project" brief becomes a Lead. Zoho's workflow rules
# send the team alert and the client's confirmation email.
# Self Client from https://api-console.zoho.com (scopes:
# ZohoCRM.modules.ALL,ZohoCRM.settings.ALL,ZohoCRM.users.READ,ZohoCRM.org.READ).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Zoho user (by sign-in email) who owns new leads
ZOHO_LEAD_OWNER_EMAIL=
# Only for accounts outside the US data centre, e.g. https://accounts.zoho.eu
ZOHO_ACCOUNTS_URL=

# Cloudinary (same account as the CMS): brief attachments are stored privately
# and shared as signed download links that expire (default 30 days).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BRIEF_FILE_LINK_DAYS=

# WhatsApp alert for email and phone-call briefs, sent to Sleeky's existing
# WhatsApp number via CallMeBot (no Meta account needed). On the phone with that
# number, message CallMeBot once to get the API key (see README).
CALLMEBOT_API_KEY=
# Number to alert; default 2349160952000 (the number on the website)
WHATSAPP_ALERT_NUMBER=
