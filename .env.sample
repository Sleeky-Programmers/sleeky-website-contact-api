EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
RECAPTCHA_SECRET_KEY=
# Set to true to skip reCAPTCHA while testing (local or Vercel preview). Ignored in production.
RECAPTCHA_DISABLED=

# The EMAIL_* settings above are only used by the older /email contact form.

# Zoho CRM: every "Start a project" brief becomes a Lead. Zoho's workflow rules
# send the team alert and the client's confirmation email.
# Self Client from https://api-console.zoho.com (scopes:
# ZohoCRM.modules.ALL,ZohoCRM.settings.ALL,ZohoCRM.users.READ,ZohoCRM.org.READ).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Zoho user (by sign-in email) who owns new leads
ZOHO_LEAD_OWNER_EMAIL=
# Only for accounts outside the US data centre, e.g. https://accounts.zoho.eu
ZOHO_ACCOUNTS_URL=
